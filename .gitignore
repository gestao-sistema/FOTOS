# ---------------------------------------------------------------
#  Fotos ORIGINAIS de estudio (~8 GB, arquivos de 10 a 90 MB)
#  Nao vao para o GitHub: o limite e de 2 GB por push e 100 MB por
#  arquivo. Elas ficam so no PC / OneDrive.
#  O mural usa as copias leves da pasta _otimizadas, que SOBEM.
# ---------------------------------------------------------------
FOTOS/

# videos ORIGINAIS (2,2 GB, um deles com 80 MB) ficam so no PC.
# As versoes leves em _otimizadas/ SOBEM - por isso a excecao logo abaixo.
*.mp4
*.mov
*.avi
*.mkv
*.m4v
!_otimizadas/**/*.mp4

# ffmpeg portatil (~150 MB): ferramenta, nao faz parte do site
_ferramentas/

# configuracao local de ferramentas
.claude/

# lixo do Windows
Thumbs.db
desktop.ini
